# Prometeusz Environment Configuration
# Copy this file to .env and configure the paths for your host system.

# Web UI port (exposed on LAN / host)
PORT=6767

# Host path to Antigravity CLI data directory (containing brain/, settings.json, etc.)
# Standalone default: ~/.gemini/antigravity-cli
ANTIGRAVITY_CLI_HOST_DIR=~/.gemini/antigravity-cli

# Host path to the 'agy' binary
# Standalone default: ~/.local/bin/agy or /usr/local/bin/agy
AGY_BIN_HOST_PATH=~/.local/bin/agy

# Host path to workspace directory
# Standalone default: ~/workspace
WORKSPACE_HOST_DIR=~/workspace
